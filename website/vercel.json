{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "buildfromideas.com" }], "destination": "https://buildfromideas.ai/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.buildfromideas.com" }], "destination": "https://buildfromideas.ai/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.buildfromideas.ai" }], "destination": "https://buildfromideas.ai/:path*", "permanent": true },
    { "source": "/what-we-do", "destination": "/platform", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true }
  ],
  "headers": [
    { "source": "/(img|og)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
      { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
    ] }
  ]
}
